// Firestore security rules for the Intranet project
// Location: /firestore.rules (project root)
// Deploy with: `firebase deploy --only firestore:rules`

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Calificaciones: lectura para usuarios autenticados.
    // Creación permitida solo si el user está autenticado y su UID coincide
    // con el campo `profesorId` proporcionado en el documento.
    match /calificaciones/{calId} {
      allow get, list: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.estudianteId is string
        && request.resource.data.cursoId is string
        && request.resource.data.asignatura is string
        && request.resource.data.calificacion is number
        && request.resource.data.fecha is string;

      // No permitir update/delete desde clientes (gestionar por admin)
      allow update, delete: if false;
    }

    // Citas: similares a calificaciones
    match /citas/{citaId} {
      allow get, list: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.estudianteId is string
        && request.resource.data.fecha is string
        && request.resource.data.hora is string
        && request.resource.data.motivo is string;

      allow update, delete: if false;
    }

    // Colecciones administrativas: solo administradores pueden crear/editar/borrar
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /cursos/{cursoId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /docentes/{docenteId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /usuarios/{usuarioId} {
      // Los usuarios pueden leer datos de usuarios autenticados (necesario para auto-provision)
      allow get, list: if request.auth != null;
      // Solo admin puede crear/actualizar/eliminar registros de usuarios en Firestore
      allow create, update, delete: if isAdmin();
    }

    match /estudiantes/{estId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /reservas_sala/{resId} {
      allow get, list: if request.auth != null;
      // Un profesor autenticado puede crear su propia reserva (por correo o uid)
      allow create: if request.auth != null && (
        request.resource.data.correo == request.auth.token.email ||
        request.resource.data.profesorId == request.auth.uid
      );
      // Solo admin puede modificar o borrar reservas
      allow update, delete: if isAdmin();
    }

    match /horarios_bloqueados/{hbId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Reglas por defecto: denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Notes:
// - Estas reglas suponen que la aplicación usa Firebase Auth y que
//   `profesorId` se guarda con el UID de Firebase Auth.
// - Para permitir que administradores actualicen/elimininen documentos,
//   se pueden usar custom claims (`request.auth.token.admin == true`) y
//   ajustar `allow update, delete` para administradores.
