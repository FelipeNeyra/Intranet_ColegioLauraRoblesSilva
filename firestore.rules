// Firestore security rules for the Intranet project
// Location: /firestore.rules (project root)
// Deploy with: `firebase deploy --only firestore:rules`

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ["admin1@laurarobles.cl", "admin2@laurarobles.cl"] ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "Administrador")
      );
    }

    function isOwnProfile() {
      return isSignedIn() && request.resource.data.email == request.auth.token.email;
    }

    function isProfessorDocument() {
      return isSignedIn() && request.resource.data.profesorId == request.auth.uid;
    }

    // Calificaciones: lectura para usuarios autenticados.
    // Creación permitida solo si el usuario autenticado coincide con el profesor.
    match /calificaciones/{calId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.estudianteId is string
        && request.resource.data.cursoId is string
        && request.resource.data.asignatura is string
        && request.resource.data.calificacion is number
        && request.resource.data.fecha is string;

      allow update, delete: if isAdmin();
    }

    // Citas: similares a calificaciones
    match /citas/{citaId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.estudianteId is string
        && request.resource.data.fecha is string
        && request.resource.data.hora is string
        && request.resource.data.motivo is string;

      allow update, delete: if isAdmin();
    }

    match /cursos/{cursoId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /docentes/{docenteId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /usuarios/{usuarioId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() || isOwnProfile();
      allow update, delete: if isAdmin();
    }

    match /estudiantes/{estId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /reservas_sala/{resId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.correo == request.auth.token.email ||
        request.resource.data.profesorId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /horarios_bloqueados/{hbId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Reglas por defecto: denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Notes:
// - Las reglas aceptan administradores por custom claim, por un perfil en /usuarios/{uid}
//   con rol "Administrador" y también por los correos admin iniciales del proyecto.
// - Los profesores pueden crear calificaciones, citas y reservas para su propia cuenta.
